# OpenSource Navigator AI - Backend Configuration
# Copy this file to .env for local configuration

# Optional GitHub Personal Access Token (greatly increases rate limit from 60 to 5,000 req/hr)
# NEVER commit your actual token to git!
GITHUB_TOKEN=

# Ollama local HTTP API URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Configurable open-weight model name (e.g. qwen3:4b, deepseek-r1:8b, qwen2.5:3b)
OLLAMA_MODEL=deepseek-r1:8b

# Frontend Origin for CORS validation
FRONTEND_ORIGIN=http://localhost:3000

# Backend Port
PORT=8000
